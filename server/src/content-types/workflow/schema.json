{
  "kind": "collectionType",
  "collectionName": "pw_workflows",
  "info": {
    "singularName": "workflow",
    "pluralName": "workflows",
    "displayName": "Workflow",
    "description": "Publishing workflows"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text"
    },
    "targetContentTypes": {
      "type": "json",
      "required": true,
      "default": []
    },
    "stages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::publishing-workflow.workflow-stage",
      "mappedBy": "workflow"
    }
  }
}
